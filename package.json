{
  "name": "equivale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Equivale — troque, mova, escolha. Organizador local de dieta prescrita.",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalogo:gerar && tsc -b && vite build",
    "catalogo:gerar": "node scripts/catalogo-equivalencias.mjs",
    "catalogo:validar": "node scripts/catalogo-equivalencias.mjs --validate",
    "alimentos:auditar": "node scripts/auditar-base-alimentos.mjs",
    "alimentos:gerar": "python scripts/gerar-base-alimentos.py",
    "alimentos:verificar": "python scripts/gerar-base-alimentos.py --check",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty && tsc -p tsconfig.node.json --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gerar-icones.mjs",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.1",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  }
}
